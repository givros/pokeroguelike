{
  "name": "pokeroguelike",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "check": "node --check engine.js && node --check builds.js && node --check guardians.js && node --check artwork-layout.js && node --check attack-origins.js && node --check checkpoint.js && node --check plans.js && node --check idle.js && node --check landmarks.js && node --check script.js && node --check presentation.js && node --check storage.js && node --check field-guide.js && node --check audio.js && node --check server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tools/adventure-check.mjs && node tools/lifecycle-check.mjs",
    "test:expansion": "node tools/expansion-check.mjs",
    "test:audio": "node tools/audio-check.mjs",
    "test:readability": "node tools/readability-check.mjs",
    "test:balance": "node tools/simulate.mjs",
    "test:builds": "node tools/build-check.mjs",
    "test:plans": "node tools/plan-check.mjs",
    "test:idle": "node tools/idle-check.mjs",
    "test:training": "node tools/training-check.mjs",
    "test:threat": "node tools/threat-check.mjs",
    "test:silhouettes": "node tools/silhouette-check.mjs",
    "test:motion": "node tools/motion-layout-check.mjs --all && node tools/motion-layout-check.mjs --all --windback",
    "test:combat-feedback": "node tools/combat-feedback-check.mjs",
    "test:shrine": "node tools/shrine-check.mjs",
    "test:landmarks": "node tools/landmark-check.mjs",
    "test:guardians": "node tools/guardian-check.mjs",
    "test:map-grounding": "node tools/map-visibility-check.mjs && node tools/map-grounding-check.mjs",
    "test:choice-previews": "node tools/choice-preview-check.mjs",
    "test:recovery": "node tools/recovery-check.mjs && node tools/load-notice-check.mjs && node tools/save-transition-check.mjs",
    "test:save-transitions": "node tools/save-transition-check.mjs",
    "test:elemental-fx": "node tools/elemental-fx-check.mjs && node tools/reduced-feedback-check.mjs",
    "test:reduced-feedback": "node tools/reduced-feedback-check.mjs",
    "test:projectiles": "node tools/projectile-check.mjs",
    "test:breath-origins": "node tools/breath-origin-check.mjs",
    "test:windup-cancellation": "node tools/windup-cancellation-check.mjs",
    "test:endings": "node tools/ending-check.mjs",
    "test:facing": "node tools/facing-runtime-check.mjs",
    "test:travel-captions": "node tools/travel-caption-check.mjs",
    "test:floating-reading": "node tools/floating-reading-check.mjs",
    "test:transient-reading": "node tools/transient-reading-check.mjs",
    "test:victory-reading": "node tools/victory-reading-check.mjs",
    "test:pause-scheduling": "node tools/pause-scheduling-check.mjs",
    "test:restart-stability": "node tools/restart-stability-check.mjs",
    "test:paused-visibility": "node tools/paused-visibility-check.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
